# Backend origin — no `/api`, no trailing slash. In dev the Vite proxy forwards
# /api/* here; the server's FRONTEND_ORIGIN must be this client's origin
# (http://localhost:5173 in dev) for CORS and the Google sign-in redirect.
VITE_API_URL=http://localhost:8080

# Google Maps Platform browser key: enable Maps JavaScript API + Places API (New)
# and restrict it by HTTP referrer. Never put the server's GOOGLE_PLACES_API_KEY here.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
# Map ID for Advanced Markers / cloud styling; omit to use DEMO_MAP_ID (dev only).
VITE_GOOGLE_MAPS_MAP_ID=
