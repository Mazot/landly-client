{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Global type packages — TS 6 no longer loads every @types/* by default.
       vite/client is referenced from src/vite-env.d.ts. */
    "types": ["google.maps"],

    /* Path aliases (relative to this file; `baseUrl` is deprecated since TS 6) */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", ".storybook"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
